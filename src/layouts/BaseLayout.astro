---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { content, type Lang, langPaths } from "../i18n/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="alternate" hreflang="ja" href={langPaths.ja} />
    <link rel="alternate" hreflang="it" href={langPaths.it} />
    <link rel="alternate" hreflang="en" href={langPaths.en} />
    <link rel="alternate" hreflang="x-default" href={langPaths.ja} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="font-noto">
    <Header lang={lang} t={t} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} t={t} />
  </body>
</html>
