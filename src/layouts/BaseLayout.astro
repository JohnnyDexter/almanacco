---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { alternateLinks, localizedPath, type Locale } from '@/i18n/config';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  slug?: string;
}

const { title, description, locale, slug = '' } = Astro.props;
const canonicalPath = localizedPath(locale, slug);
const canonical = new URL(canonicalPath, Astro.site).toString();
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#244536" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    {alternateLinks(slug).map((link) => <link rel="alternate" hreflang={link.locale} href={new URL(link.href, Astro.site).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('ja', slug), Astro.site).toString()} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ALMANACCO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="focus-ring sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ivory focus:px-4 focus:py-2" href="#main">Skip to content</a>
    <Header locale={locale} slug={slug} />
    <main id="main"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
