---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { content, type Lang } from "../i18n/content";
import { withBase, langHref } from "../utils/paths";

interface Props {
  lang: Lang;
  /** Slug della pagina corrente: "" per Home, "shop", "sekki", "journal", "about", "contact". */
  slug?: string;
}

const { lang, slug = "" } = Astro.props;
const t = content[lang];

const hreflangUrl = (targetLang: Lang) => new URL(withBase(langHref(targetLang, slug)), Astro.site).toString();
const logoUrl = new URL(withBase("/logo.png"), Astro.site).toString();
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={withBase("/logo.png")} />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="alternate" hreflang="ja" href={hreflangUrl("ja")} />
    <link rel="alternate" hreflang="it" href={hreflangUrl("it")} />
    <link rel="alternate" hreflang="en" href={hreflangUrl("en")} />
    <link rel="alternate" hreflang="x-default" href={hreflangUrl("ja")} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={logoUrl} />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
  </head>
  <body class="font-body">
    <Header lang={lang} t={t} slug={slug} transparent={slug === ""} />
    <main class={slug === "" ? "" : "pt-[72px] sm:pt-20"}>
      <slot />
    </main>
    <Footer lang={lang} t={t} slug={slug} />
  </body>
</html>
