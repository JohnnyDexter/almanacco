---
import type { SiteContent, Lang } from "../i18n/content";
import { withBase } from "../utils/paths";

interface Props {
  lang: Lang;
  t: SiteContent;
}

const { t } = Astro.props;
---

<section id="contatti" class="border-t border-line/70 bg-cream-soft">
  <div class="mx-auto max-w-3xl px-6 py-20">
    <p class="divider-dot flex items-center gap-2 font-noto text-xs uppercase tracking-[0.2em] text-terra">
      {t.contatti.kicker}
    </p>
    <h2 class="mt-4 font-mincho text-3xl text-ink sm:text-4xl">{t.contatti.title}</h2>

    <img
      src={withBase("/images/01-negozio.jpg")}
      alt={t.contatti.shopName}
      class="mt-8 aspect-[16/10] w-full border border-line/70 object-cover"
      loading="lazy"
    />

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <div>
        <h3 class="font-garamond text-xl italic text-ink">{t.contatti.shopName}</h3>
        <p class="mt-3 font-noto text-xs uppercase tracking-[0.15em] text-olive">{t.contatti.addressLabel}</p>
        <address class="mt-2 space-y-0.5 font-noto text-sm not-italic leading-relaxed text-ink-soft">
          {t.contatti.addressLines.map((line) => (
            <p>{line}</p>
          ))}
        </address>
      </div>

      <div>
        <p class="font-noto text-xs uppercase tracking-[0.15em] text-olive">{t.contatti.hoursLabel}</p>
        <p class="mt-2 font-noto text-sm leading-relaxed text-ink-soft">{t.contatti.hoursValue}</p>

        <p class="mt-6 font-noto text-xs uppercase tracking-[0.15em] text-olive">{t.contatti.socialLabel}</p>
        <p class="mt-2 font-noto text-sm leading-relaxed text-ink-soft">{t.contatti.socialValue}</p>
      </div>
    </div>

    <p class="mt-10 border-t border-line/70 pt-6 font-noto text-xs leading-relaxed text-ink-soft/80">
      {t.contatti.note}
    </p>
  </div>
</section>
