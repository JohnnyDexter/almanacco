---
import BaseLayout from "../layouts/BaseLayout.astro";
import { content, type Lang } from "../i18n/content";
import { withBase, langHref } from "../utils/paths";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<BaseLayout lang={lang} slug="">
  <section class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-6 py-24 text-center">
    <p class="divider-dot flex items-center gap-2 font-body text-xs uppercase tracking-[0.2em] text-forest">
      {t.hero.kicker}
    </p>
    <h1 class="mt-6 font-display text-5xl uppercase tracking-wide text-charcoal sm:text-6xl">
      {t.hero.title}
    </h1>
    <p class="mt-6 max-w-xl font-subtitle text-2xl italic text-stone-text">
      {t.hero.subtitle}
    </p>
    <a
      href={withBase(langHref(lang, "shop"))}
      class="mt-10 inline-block border border-forest bg-forest px-8 py-3 font-body text-sm uppercase tracking-[0.15em] text-ivory transition-colors hover:bg-transparent hover:text-forest"
    >
      {t.hero.cta}
    </a>
  </section>
</BaseLayout>
