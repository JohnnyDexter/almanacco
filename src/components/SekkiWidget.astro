---
import AlmanacWheel from "./AlmanacWheel.astro";
import { sekki, getCurrentSekkiIndex, formatSekkiDateRange } from "../data/calendar";
import { sekkiProductNames, productSlug } from "../data/sekkiProducts";
import { content, type Lang } from "../i18n/content";
import { withBase, langHref } from "../utils/paths";

interface Props {
  lang: Lang;
  /** Mostra kicker/titolo/descrizione a fianco della ruota, in un layout a due colonne. Disattivalo quando il componente è già annidato in una pagina con un proprio titolo (es. la pagina Sekki). */
  showHeading?: boolean;
  /** Mostra il link "Scopri di più" verso la pagina Sekki. Disattivalo se il widget è già sulla pagina Sekki stessa. */
  showCta?: boolean;
}

const { lang, showHeading = true, showCta = true } = Astro.props;
const t = content[lang];

// Indice calcolato al momento della build: verrà corretto lato client sulla
// data reale del visitatore appena la pagina viene caricata.
const buildIndex = getCurrentSekkiIndex();
const current = sekki[buildIndex];
const sekkiHref = withBase(langHref(lang, "sekki"));
const shopHref = withBase(langHref(lang, "shop"));

const seasonalProductName = sekkiProductNames[buildIndex];
const seasonalProduct = t.prodotti.items.find((p) => p.name === seasonalProductName)!;
---

<section id="sekki-corrente" class="scroll-mt-28 border-t border-brass/30 bg-ivory-soft py-24" data-sekki-widget>
  <div
    class={showHeading
      ? "mx-auto grid max-w-6xl gap-12 px-6 lg:grid-cols-[2fr_3fr] lg:items-center"
      : "mx-auto max-w-3xl px-6 text-center"}
  >
    {showHeading && (
      <div>
        <p class="divider-dot flex items-center gap-2 font-body text-xs uppercase tracking-[0.2em] text-forest">
          {t.sekkiWidget.kicker}
        </p>
        <h2 class="mt-4 font-display text-3xl uppercase tracking-wide text-charcoal sm:text-4xl">
          {t.sekkiWidget.title}
        </h2>
        <p class="mt-5 max-w-sm font-subtitle text-xl italic leading-relaxed text-stone-text">
          {t.sekkiWidget.description}
        </p>
        {showCta && (
          <a
            href={sekkiHref}
            class="mt-8 inline-block border-b border-forest font-body text-sm uppercase tracking-[0.15em] text-forest transition-colors hover:border-charcoal hover:text-charcoal"
          >
            {t.sekkiWidget.ctaLabel} →
          </a>
        )}
      </div>
    )}

    <div>
      <div class="flex flex-wrap items-center justify-center gap-5 sm:flex-nowrap sm:gap-3 lg:gap-6">
        <button
          type="button"
          data-sekki-prev
          aria-label={t.sekkiWidget.prevLabel}
          class="order-2 flex h-11 w-11 shrink-0 items-center justify-center border border-brass/50 text-charcoal transition-colors hover:border-forest hover:text-forest sm:order-1"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>

        <div class="relative order-1 mx-auto w-full max-w-[22rem] sm:order-2 sm:w-auto sm:max-w-sm md:max-w-md">
          <AlmanacWheel lang={lang} highlightIndex={buildIndex} />
          <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
            <div class="flex w-48 flex-col items-center text-center sm:w-52">
              <span data-field="kanji" class="font-display text-4xl text-charcoal sm:text-4xl">{current.kanji}</span>
              <span data-field="romaji" class="mt-1 font-subtitle text-xl italic text-stone-text sm:text-lg">{current.romaji}</span>
              <span data-field="date" class="mt-2 font-body text-xs uppercase tracking-wide text-brass sm:text-[11px]">
                {formatSekkiDateRange(lang, buildIndex)}
              </span>
              <span data-field="meaning" class="mt-2 font-body text-sm leading-snug text-stone-text sm:text-xs">
                {current.meaning[lang]}
              </span>
            </div>
          </div>
        </div>

        <button
          type="button"
          data-sekki-next
          aria-label={t.sekkiWidget.nextLabel}
          class="order-3 flex h-11 w-11 shrink-0 items-center justify-center border border-brass/50 text-charcoal transition-colors hover:border-forest hover:text-forest"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
            <polyline points="9 6 15 12 9 18" />
          </svg>
        </button>
      </div>

      <div class="mt-10 border-t border-brass/20 pt-6 text-center">
        <p class="font-body text-[10px] uppercase tracking-[0.2em] text-brass">
          {t.sekkiWidget.seasonalProductLabel}
        </p>
        <a
          data-field="product-link"
          href={`${shopHref}#${productSlug(seasonalProduct.name)}`}
          class="mt-2 inline-flex items-center gap-1.5 font-subtitle text-lg italic text-charcoal transition-colors hover:text-forest"
        >
          <span data-field="product-name">{seasonalProduct.name}</span> →
        </a>
        <p data-field="product-category" class="mt-1 font-body text-xs text-stone-text">
          {seasonalProduct.category}
        </p>
      </div>

      {!showHeading && showCta && (
        <a
          href={sekkiHref}
          class="mt-6 inline-block border-b border-forest font-body text-sm uppercase tracking-[0.15em] text-forest transition-colors hover:border-charcoal hover:text-charcoal"
        >
          {t.sekkiWidget.ctaLabel} →
        </a>
      )}
    </div>
  </div>
</section>

<script>
  import { sekki, getCurrentSekkiIndex, formatSekkiDateRange } from "../data/calendar";
  import { sekkiProductNames, productSlug } from "../data/sekkiProducts";
  import { content, type Lang } from "../i18n/content";
  import { withBase, langHref } from "../utils/paths";

  function initSekkiWidget(section: Element) {
    const lang = (document.documentElement.lang || "en").slice(0, 2) as Lang;
    const t = content[lang] ?? content.en;
    const shopHref = withBase(langHref(lang, "shop"));
    const wheel = section.querySelector<SVGSVGElement>("[data-sekki-wheel]");
    const kanjiEl = section.querySelector<HTMLElement>('[data-field="kanji"]');
    const romajiEl = section.querySelector<HTMLElement>('[data-field="romaji"]');
    const dateEl = section.querySelector<HTMLElement>('[data-field="date"]');
    const meaningEl = section.querySelector<HTMLElement>('[data-field="meaning"]');
    const prevBtn = section.querySelector<HTMLButtonElement>("[data-sekki-prev]");
    const nextBtn = section.querySelector<HTMLButtonElement>("[data-sekki-next]");
    const productLinkEl = section.querySelector<HTMLAnchorElement>('[data-field="product-link"]');
    const productNameEl = section.querySelector<HTMLElement>('[data-field="product-name"]');
    const productCategoryEl = section.querySelector<HTMLElement>('[data-field="product-category"]');
    if (!wheel || !kanjiEl || !romajiEl || !dateEl || !meaningEl || !prevBtn || !nextBtn) return;

    let index = getCurrentSekkiIndex();

    function render() {
      const s = sekki[index];
      kanjiEl!.textContent = s.kanji;
      romajiEl!.textContent = s.romaji;
      dateEl!.textContent = formatSekkiDateRange(lang, index);
      meaningEl!.textContent = s.meaning[lang] ?? s.meaning.en;

      if (productLinkEl && productNameEl && productCategoryEl) {
        const productName = sekkiProductNames[index];
        const product = t.prodotti.items.find((p) => p.name === productName);
        if (product) {
          productNameEl.textContent = product.name;
          productCategoryEl.textContent = product.category;
          productLinkEl.href = `${shopHref}#${productSlug(product.name)}`;
        }
      }

      wheel!.querySelectorAll<SVGLineElement>("[data-sekki-tick]").forEach((el) => {
        const i = Number(el.dataset.sekkiTick);
        const active = i === index;
        el.setAttribute("stroke", active ? "var(--color-terracotta)" : "var(--color-stone-text)");
        el.setAttribute("stroke-width", active ? "2" : "0.75");
        el.setAttribute("opacity", active ? "1" : "0.55");
      });
      wheel!.querySelectorAll<SVGTextElement>("[data-sekki-label]").forEach((el) => {
        const i = Number(el.dataset.sekkiLabel);
        const active = i === index;
        el.setAttribute("fill", active ? "var(--color-terracotta)" : "var(--color-stone-text)");
        el.setAttribute("font-weight", active ? "600" : "400");
      });
    }

    // Corregge l'indice calcolato in build-time sulla data reale del visitatore.
    index = getCurrentSekkiIndex(new Date());
    render();

    prevBtn.addEventListener("click", () => {
      index = (index - 1 + sekki.length) % sekki.length;
      render();
    });
    nextBtn.addEventListener("click", () => {
      index = (index + 1) % sekki.length;
      render();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-sekki-widget]").forEach(initSekkiWidget);
</script>
