---
import AlmanacWheel from "./AlmanacWheel.astro";
import { sekki, getCurrentSekkiIndex, formatSekkiDate } from "../data/calendar";
import { content, type Lang } from "../i18n/content";
import { withBase, langHref } from "../utils/paths";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];

// Indice calcolato al momento della build: verrà corretto lato client sulla
// data reale del visitatore appena la pagina viene caricata.
const buildIndex = getCurrentSekkiIndex();
const current = sekki[buildIndex];
const sekkiHref = withBase(langHref(lang, "sekki"));
---

<section class="border-t border-brass/30 bg-ivory-soft py-24" data-sekki-widget>
  <div class="mx-auto max-w-3xl px-6 text-center">
    <p class="divider-dot flex items-center justify-center gap-2 font-body text-xs uppercase tracking-[0.2em] text-forest">
      {t.sekkiWidget.kicker}
    </p>
    <h2 class="mt-4 font-display text-3xl uppercase tracking-wide text-charcoal sm:text-4xl">
      {t.sekkiWidget.title}
    </h2>

    <div class="mt-12 flex items-center justify-center gap-3 sm:gap-6">
      <button
        type="button"
        data-sekki-prev
        aria-label={t.sekkiWidget.prevLabel}
        class="flex h-10 w-10 shrink-0 items-center justify-center border border-brass/50 text-charcoal transition-colors hover:border-forest hover:text-forest"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>

      <div class="relative mx-auto w-full max-w-sm sm:max-w-md">
        <AlmanacWheel lang={lang} highlightIndex={buildIndex} />
        <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
          <div class="flex w-40 flex-col items-center text-center sm:w-48">
            <span data-field="kanji" class="font-display text-3xl text-charcoal sm:text-4xl">{current.kanji}</span>
            <span data-field="romaji" class="mt-1 font-subtitle text-lg italic text-stone-text">{current.romaji}</span>
            <span data-field="date" class="mt-2 font-body text-[11px] uppercase tracking-wide text-brass">
              {formatSekkiDate(lang, current)}
            </span>
            <span data-field="meaning" class="mt-2 font-body text-xs leading-snug text-stone-text">
              {current.meaning[lang]}
            </span>
          </div>
        </div>
      </div>

      <button
        type="button"
        data-sekki-next
        aria-label={t.sekkiWidget.nextLabel}
        class="flex h-10 w-10 shrink-0 items-center justify-center border border-brass/50 text-charcoal transition-colors hover:border-forest hover:text-forest"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
          <polyline points="9 6 15 12 9 18" />
        </svg>
      </button>
    </div>

    <a
      href={sekkiHref}
      class="mt-10 inline-block border-b border-forest font-body text-sm uppercase tracking-[0.15em] text-forest transition-colors hover:border-charcoal hover:text-charcoal"
    >
      {t.sekkiWidget.ctaLabel} →
    </a>
  </div>
</section>

<script>
  import { sekki, getCurrentSekkiIndex, formatSekkiDate } from "../data/calendar";
  import type { Lang } from "../i18n/content";

  function initSekkiWidget(section: Element) {
    const lang = (document.documentElement.lang || "en").slice(0, 2) as Lang;
    const wheel = section.querySelector<SVGSVGElement>("[data-sekki-wheel]");
    const kanjiEl = section.querySelector<HTMLElement>('[data-field="kanji"]');
    const romajiEl = section.querySelector<HTMLElement>('[data-field="romaji"]');
    const dateEl = section.querySelector<HTMLElement>('[data-field="date"]');
    const meaningEl = section.querySelector<HTMLElement>('[data-field="meaning"]');
    const prevBtn = section.querySelector<HTMLButtonElement>("[data-sekki-prev]");
    const nextBtn = section.querySelector<HTMLButtonElement>("[data-sekki-next]");
    if (!wheel || !kanjiEl || !romajiEl || !dateEl || !meaningEl || !prevBtn || !nextBtn) return;

    let index = getCurrentSekkiIndex();

    function render() {
      const s = sekki[index];
      kanjiEl!.textContent = s.kanji;
      romajiEl!.textContent = s.romaji;
      dateEl!.textContent = formatSekkiDate(lang, s);
      meaningEl!.textContent = s.meaning[lang] ?? s.meaning.en;

      wheel!.querySelectorAll<SVGLineElement>("[data-sekki-tick]").forEach((el) => {
        const i = Number(el.dataset.sekkiTick);
        const active = i === index;
        el.setAttribute("stroke", active ? "var(--color-terracotta)" : "var(--color-stone-text)");
        el.setAttribute("stroke-width", active ? "2" : "0.75");
        el.setAttribute("opacity", active ? "1" : "0.55");
      });
      wheel!.querySelectorAll<SVGTextElement>("[data-sekki-label]").forEach((el) => {
        const i = Number(el.dataset.sekkiLabel);
        const active = i === index;
        el.setAttribute("fill", active ? "var(--color-terracotta)" : "var(--color-stone-text)");
        el.setAttribute("font-weight", active ? "600" : "400");
      });
    }

    // Corregge l'indice calcolato in build-time sulla data reale del visitatore.
    index = getCurrentSekkiIndex(new Date());
    render();

    prevBtn.addEventListener("click", () => {
      index = (index - 1 + sekki.length) % sekki.length;
      render();
    });
    nextBtn.addEventListener("click", () => {
      index = (index + 1) % sekki.length;
      render();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-sekki-widget]").forEach(initSekkiWidget);
</script>
