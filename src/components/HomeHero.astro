---
import { content, type Lang } from "../i18n/content";
import { withBase, langHref } from "../utils/paths";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section class="relative flex min-h-[90vh] items-center justify-center overflow-hidden">
  <img
    src={withBase("/images/01-negozio.jpg")}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
  />
  <div class="absolute inset-0 bg-charcoal/65" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-charcoal/75 via-charcoal/40 to-charcoal/55" aria-hidden="true"></div>

  <div class="relative z-10 flex flex-col items-center px-6 py-24 text-center">
    <div class="relative flex items-center justify-center">
      <div
        class="absolute h-24 w-24 rounded-full border border-brass/30 bg-ivory/15 sm:h-28 sm:w-28"
        aria-hidden="true"
      ></div>
      <img
        src={withBase("/logo-swallow-light.png")}
        alt=""
        class="relative h-16 w-auto sm:h-20"
        width="594"
        height="563"
      />
    </div>
    <h1 class="mt-6 font-display text-5xl uppercase tracking-[0.08em] text-ivory sm:text-6xl">
      {t.hero.title}
    </h1>
    <p class="mt-5 max-w-lg font-subtitle text-xl italic tracking-wide text-ivory/90 sm:text-2xl">
      {t.hero.subtitle}
    </p>
    <p class="mt-4 max-w-md font-body text-base leading-relaxed text-ivory/85 sm:text-lg">
      {t.hero.text}
    </p>
    <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row">
      <a
        href={withBase(langHref(lang, "shop"))}
        class="inline-block bg-forest px-9 py-3.5 font-body text-sm uppercase tracking-[0.15em] text-ivory transition-colors hover:bg-forest/85"
      >
        {t.hero.ctaPrimary} →
      </a>
      <a
        href={withBase(langHref(lang, "journal"))}
        class="inline-block border border-ivory/70 px-9 py-3.5 font-body text-sm uppercase tracking-[0.15em] text-ivory transition-colors hover:border-ivory hover:bg-ivory/10"
      >
        {t.hero.ctaSecondary} →
      </a>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex justify-center pb-4" aria-hidden="true">
    <svg viewBox="0 0 1200 70" class="h-auto w-full max-w-3xl px-10" preserveAspectRatio="none">
      <path
        d="M0,44 C150,20 300,55 450,38 C600,22 750,50 900,34 C1000,24 1100,30 1200,18"
        fill="none"
        stroke="var(--color-brass)"
        stroke-width="1.25"
        opacity="0.85"
      />
      <image
        href={withBase("/logo-swallow-light.png")}
        x="900"
        y="0"
        width="90"
        height="85"
        opacity="0.95"
      />
    </svg>
  </div>
</section>
