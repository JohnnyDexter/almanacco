---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { SiteContent, Lang } from "../i18n/content";
import { withBase } from "../utils/paths";

interface Props {
  lang: Lang;
  t: SiteContent;
}

const { lang, t } = Astro.props;
---

<header class="sticky top-0 z-30 border-b border-line/70 bg-cream/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href={withBase(`/${lang}/`)} class="flex items-center">
      <img
        src={withBase("/logo-mark.jpg")}
        alt="Almanacco"
        class="h-14 w-auto sm:h-16"
        width="594"
        height="563"
      />
    </a>
    <nav aria-label="Sezioni" class="hidden gap-6 font-noto text-sm text-ink-soft md:flex">
      <a href="#storia" class="transition-colors hover:text-olive">{t.nav.storia}</a>
      <a href="#prodotti" class="transition-colors hover:text-olive">{t.nav.prodotti}</a>
      <a href="#almanacco" class="transition-colors hover:text-olive">{t.nav.almanacco}</a>
      <a href="#contatti" class="transition-colors hover:text-olive">{t.nav.contatti}</a>
    </nav>
    <LanguageSwitcher current={lang} />
  </div>
</header>
