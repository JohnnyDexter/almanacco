---
import type { SiteContent, Lang } from "../i18n/content";

interface Props {
  lang: Lang;
  t: SiteContent;
}

const { t } = Astro.props;
---

<section id="almanacco" class="border-t border-indigo-line/70 bg-night">
  <div class="mx-auto max-w-3xl px-6 py-20">
    <p class="divider-dot flex items-center gap-2 font-noto text-xs uppercase tracking-[0.2em] text-terra">
      {t.almanacco.kicker}
    </p>
    <h2 class="mt-4 font-mincho text-3xl text-paper sm:text-4xl">{t.almanacco.title}</h2>
    <p class="mt-4 font-noto text-base leading-relaxed text-paper-dim">{t.almanacco.intro}</p>

    <div class="mt-10 border border-olive-soft/60 bg-night-panel p-8">
      <span class="font-noto text-xs uppercase tracking-[0.15em] text-olive">{t.almanacco.eventLabel}</span>
      <h3 class="mt-3 font-garamond text-2xl italic text-paper">{t.almanacco.eventTitle}</h3>
      <p class="mt-4 font-noto text-sm leading-relaxed text-paper-dim">{t.almanacco.eventText}</p>
      <div class="mt-6 border-t border-indigo-line/70 pt-4">
        <span class="font-noto text-xs uppercase tracking-[0.15em] text-terra">{t.almanacco.pairingLabel}</span>
        <p class="mt-2 font-noto text-sm leading-relaxed text-paper-dim">{t.almanacco.pairingText}</p>
      </div>
    </div>
  </div>
</section>
