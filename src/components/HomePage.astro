---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./Hero.astro";
import Storia from "./Storia.astro";
import Prodotti from "./Prodotti.astro";
import AlmanaccoStagionale from "./AlmanaccoStagionale.astro";
import Contatti from "./Contatti.astro";
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<BaseLayout lang={lang}>
  <Hero lang={lang} t={t} />
  <Storia lang={lang} t={t} />
  <Prodotti lang={lang} t={t} />
  <AlmanaccoStagionale lang={lang} t={t} />
  <Contatti lang={lang} t={t} />
</BaseLayout>
