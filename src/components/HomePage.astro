---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localizedPath, type Locale } from '@/i18n/config';
import { home } from '@/i18n/ui';
const { locale } = Astro.props as { locale: Locale };
const t = home[locale];
const products = [
  ['Olio Verde', 'Single-estate extra virgin olive oil', 'bg-forest'],
  ['Sale di Mare', 'Hand-harvested sea salt', 'bg-brass'],
  ['Casa Linen', 'Natural table linen for quiet rituals', 'bg-terracotta'],
];
const events = [
  ['2026.09.12', 'Seasonal tasting salon', 'Tokyo'],
  ['2026.10.04', 'Olive harvest talk', 'Kyoto'],
];
---
<BaseLayout locale={locale} title={t.metaTitle} description={t.metaDescription}>
  <section class="container-premium grid min-h-[78vh] items-center gap-14 py-20 lg:grid-cols-[1.05fr_0.95fr]">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="mt-6 max-w-4xl font-display text-6xl leading-[0.92] tracking-tight text-forest md:text-8xl">{t.title}</h1>
      <p class="mt-8 max-w-2xl text-lg leading-9 text-charcoal/70">{t.intro}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a class="focus-ring rounded-full bg-forest px-7 py-4 text-sm font-bold text-ivory shadow-editorial hover:bg-charcoal" href={localizedPath(locale, 'products')}>{t.cta}</a>
        <a class="focus-ring rounded-full border border-charcoal/15 px-7 py-4 text-sm font-bold text-charcoal hover:border-forest hover:text-forest" href={localizedPath(locale, 'about')}>{t.secondary}</a>
      </div>
    </div>
    <figure class="relative" aria-label="Editorial still life illustration">
      <div class="aspect-[4/5] rounded-t-full bg-gradient-to-br from-stone via-ivory to-brass/60 p-6 shadow-editorial">
        <div class="h-full rounded-t-full border border-ivory/80 bg-[radial-gradient(circle_at_50%_25%,rgba(255,255,255,.72),transparent_30%),linear-gradient(160deg,#244536,#B8654B)]"></div>
      </div>
      <figcaption class="absolute bottom-8 left-8 rounded-full bg-ivory/95 px-5 py-3 text-sm font-semibold text-forest shadow-soft">Tokyo / Italia</figcaption>
    </figure>
  </section>

  <section class="bg-forest py-20 text-ivory">
    <div class="container-premium grid gap-8 md:grid-cols-3">
      <p class="eyebrow text-brass">About</p>
      <h2 class="font-display text-4xl leading-tight md:col-span-2 md:text-6xl">Materials, seasons, and human craft are edited into a quieter way of living.</h2>
    </div>
  </section>

  <section class="container-premium py-20">
    <div class="flex items-end justify-between gap-6">
      <div><p class="eyebrow">Featured products</p><h2 class="section-title mt-4">Essential objects, considered slowly.</h2></div>
      <a class="hidden text-sm font-bold text-forest hover:text-brass md:inline" href={localizedPath(locale, 'products')}>View all</a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {products.map(([name, detail, color]) => (
        <article class="editorial-card">
          <div class:list={['mb-8 h-56 rounded-[1.5rem]', color]}></div>
          <h3 class="font-display text-3xl text-forest">{name}</h3>
          <p class="mt-2 text-sm leading-7 text-charcoal/65">{detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container-premium grid gap-10 py-20 lg:grid-cols-2">
    <div><p class="eyebrow">Events</p><h2 class="section-title mt-4">Seasonal gatherings</h2></div>
    <div class="space-y-4">
      {events.map(([date, title, place]) => (
        <article class="rounded-3xl border border-charcoal/10 bg-porcelain/50 p-6">
          <p class="text-sm font-bold text-brass">{date} · {place}</p>
          <h3 class="mt-2 font-display text-3xl text-forest">{title}</h3>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-stone/45 py-20">
    <div class="container-premium grid gap-8 md:grid-cols-3">
      <div><p class="eyebrow">Journal</p><h2 class="mt-4 font-display text-4xl leading-tight text-forest">Stories from the table</h2></div>
      <article class="editorial-card md:col-span-2"><p class="text-base leading-8 text-charcoal/70">Notes from olive groves, workshops, markets, and tables — prepared for future content collections.</p></article>
    </div>
  </section>

  <section class="container-premium grid gap-8 py-20 md:grid-cols-2">
    <article class="editorial-card"><p class="eyebrow">Instagram</p><h2 class="mt-4 font-display text-4xl text-forest">@almanacco</h2><p class="mt-4 leading-8 text-charcoal/65">A curated feed for seasonal arrivals, tastings, and quiet table inspiration.</p></article>
    <article class="rounded-[2rem] bg-forest p-8 text-ivory shadow-editorial"><p class="eyebrow text-brass">Map</p><h2 class="mt-4 font-display text-4xl">Tokyo showroom</h2><p class="mt-4 leading-8 text-ivory/70">Jingumae, Shibuya-ku, Tokyo. Visits by appointment.</p></article>
  </section>
</BaseLayout>
