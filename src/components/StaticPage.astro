---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/i18n/config';
const { locale, slug, title, description } = Astro.props as { locale: Locale; slug: string; title: string; description: string };
---
<BaseLayout locale={locale} slug={slug} title={`${title} | ALMANACCO`} description={description}>
  <section class="container-premium py-24 md:py-32">
    <p class="eyebrow">ALMANACCO</p>
    <h1 class="mt-5 section-title">{title}</h1>
    <p class="mt-8 max-w-3xl text-lg leading-9 text-charcoal/70">{description}</p>
    <div class="mt-12 grid gap-6 lg:grid-cols-[1fr_0.7fr]">
      <div class="editorial-card"><slot /></div>
      <aside class="rounded-[2rem] bg-forest p-8 text-ivory"><p class="eyebrow text-brass">Information</p><p class="mt-5 leading-8 text-ivory/70">This page is structured for future editorial, product, and event content managed through Astro Content Collections.</p></aside>
    </div>
  </section>
</BaseLayout>
