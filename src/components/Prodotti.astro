---
import type { SiteContent, Lang } from "../i18n/content";
import { withBase } from "../utils/paths";

interface Props {
  lang: Lang;
  t: SiteContent;
}

const { t } = Astro.props;
---

<section id="prodotti" class="border-t border-line/70 bg-cream-soft">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <p class="divider-dot flex items-center gap-2 font-noto text-xs uppercase tracking-[0.2em] text-terra">
      {t.prodotti.kicker}
    </p>
    <h2 class="mt-4 font-mincho text-3xl text-ink sm:text-4xl">{t.prodotti.title}</h2>
    <p class="mt-4 max-w-2xl font-noto text-base leading-relaxed text-ink-soft">{t.prodotti.intro}</p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {t.prodotti.items.map((item) => (
        <article class="flex flex-col border border-line/70 bg-cream-panel">
          {item.image ? (
            <img
              src={withBase(item.image)}
              alt={item.name}
              class="aspect-[4/3] w-full object-cover"
              loading="lazy"
            />
          ) : (
            <div class="flex aspect-[4/3] w-full items-center justify-center bg-cream-soft" aria-hidden="true">
              <svg viewBox="0 0 64 64" class="h-12 w-12">
                <circle cx="32" cy="32" r="22" fill="none" stroke="var(--color-olive-soft)" stroke-width="1" />
                <circle cx="32" cy="32" r="13" fill="none" stroke="var(--color-olive-soft)" stroke-width="1" />
                <circle cx="32" cy="32" r="1.6" fill="var(--color-terra)" />
              </svg>
            </div>
          )}
          <div class="flex flex-col gap-3 p-6">
            <span class="font-noto text-xs uppercase tracking-[0.15em] text-olive">{item.category}</span>
            <h3 class="font-garamond text-2xl italic text-ink">{item.name}</h3>
            <p class="font-noto text-sm leading-relaxed text-ink-soft">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
