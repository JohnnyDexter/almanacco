---
import BaseLayout from "../layouts/BaseLayout.astro";
import { content, type Lang } from "../i18n/content";
import { withBase } from "../utils/paths";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<BaseLayout lang={lang} slug="events">
  <section class="bg-ivory py-24">
    <div class="mx-auto max-w-3xl px-6">
      <p class="divider-dot flex items-center gap-2 font-body text-xs uppercase tracking-[0.2em] text-forest">
        {t.almanacco.kicker}
      </p>
      <h1 class="mt-4 font-display text-4xl uppercase tracking-wide text-charcoal sm:text-5xl">
        {t.almanacco.title}
      </h1>
      <p class="mt-6 font-subtitle text-xl italic leading-relaxed text-stone-text">
        {t.almanacco.intro}
      </p>

      <div class="mt-14 border border-brass/30 bg-ivory-soft">
        <img
          src={withBase("/images/events/tagliatelle-ragu.jpg")}
          alt={t.almanacco.eventImageAlt}
          class="aspect-[16/9] w-full object-cover"
          loading="lazy"
        />
        <div class="p-8 sm:p-10">
          <span class="font-body text-xs uppercase tracking-[0.15em] text-forest">{t.almanacco.eventLabel}</span>
          <h2 class="mt-3 font-subtitle text-2xl italic text-charcoal sm:text-3xl">{t.almanacco.eventTitle}</h2>
          <p class="mt-4 font-body text-sm leading-relaxed text-stone-text">{t.almanacco.eventText}</p>
          <div class="mt-6 border-t border-brass/30 pt-5">
            <span class="font-body text-xs uppercase tracking-[0.15em] text-terracotta-text">{t.almanacco.pairingLabel}</span>
            <p class="mt-2 font-body text-sm leading-relaxed text-stone-text">{t.almanacco.pairingText}</p>
          </div>
        </div>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <img
          src={withBase("/images/events/gruppo-evento.jpg")}
          alt={t.almanacco.groupImageAlt}
          class="aspect-[4/3] w-full border border-brass/30 object-cover"
          loading="lazy"
        />
        <img
          src={withBase("/images/events/degustazione.jpg")}
          alt={t.almanacco.tastingImageAlt}
          class="aspect-[4/3] w-full border border-brass/30 object-cover"
          loading="lazy"
        />
      </div>

      <p class="mt-10 text-center font-body text-xs leading-relaxed text-stone-text/80">
        {t.almanacco.moreNote}
      </p>
    </div>
  </section>

  <section class="border-t border-brass/30 bg-ivory-soft py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        {t.almanacco.gallery.map((img) => (
          <img
            src={withBase(img.src)}
            alt={img.alt}
            class="aspect-square w-full border border-brass/30 object-cover"
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
