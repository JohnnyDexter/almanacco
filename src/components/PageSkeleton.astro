---
import BaseLayout from "../layouts/BaseLayout.astro";
import { content, type Lang, type PageSkeletonContent } from "../i18n/content";

interface Props {
  lang: Lang;
  slug: string;
  page: PageSkeletonContent;
}

const { lang, slug, page } = Astro.props;
const t = content[lang];
---

<BaseLayout lang={lang} slug={slug}>
  <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center px-6 py-28 text-center">
    <p class="divider-dot flex items-center gap-2 font-body text-xs uppercase tracking-[0.2em] text-forest">
      {t.comingSoonLabel}
    </p>
    <h1 class="mt-5 font-display text-4xl uppercase tracking-wide text-charcoal sm:text-5xl">
      {page.title}
    </h1>
    <p class="mt-6 font-subtitle text-xl italic text-stone-text">
      {page.description}
    </p>
  </section>
</BaseLayout>
