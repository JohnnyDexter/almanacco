---
import { italianMonths, sekki, type MonthLabel } from "../data/calendar";
import type { Lang } from "../i18n/content";

interface Props {
  lang: Lang;
  /** Indice (0-23) del sekki da evidenziare, per il widget "sekki del momento". */
  highlightIndex?: number;
}

const { lang, highlightIndex } = Astro.props;

const size = 480;
const cx = size / 2;
const cy = size / 2;

const outerRadius = 225;
const outerLabelRadius = 200;
const innerRadius = 168;
const innerLabelRadius = 141;
const coreRadius = 108;

function toRad(deg: number) {
  return (deg * Math.PI) / 180;
}

function pointOnCircle(radius: number, angleDeg: number) {
  const rad = toRad(angleDeg - 90);
  return {
    x: cx + radius * Math.cos(rad),
    y: cy + radius * Math.sin(rad),
  };
}

function labelTransform(angleDeg: number, radius: number) {
  const flip = angleDeg > 90 && angleDeg < 270;
  const pos = pointOnCircle(radius, angleDeg);
  const rotation = flip ? angleDeg - 90 + 180 : angleDeg - 90;
  return `rotate(${rotation} ${pos.x} ${pos.y})`;
}

const monthStep = 360 / italianMonths.length;
const monthItems = italianMonths.map((m: MonthLabel, i: number) => {
  const angle = i * monthStep;
  const pos = pointOnCircle(outerLabelRadius, angle);
  return {
    label: m[lang],
    x: pos.x,
    y: pos.y,
    transform: labelTransform(angle, outerLabelRadius),
  };
});

const sekkiStep = 360 / sekki.length;
const sekkiItems = sekki.map((s, i) => {
  const angle = i * sekkiStep;
  const pos = pointOnCircle(innerLabelRadius, angle);
  return {
    label: s.kanji,
    x: pos.x,
    y: pos.y,
    transform: labelTransform(angle, innerLabelRadius),
  };
});

const tickAnglesOuter = italianMonths.map((_, i) => i * monthStep);
const tickAnglesInner = sekki.map((_, i) => i * sekkiStep);
---

<figure class="mx-auto flex w-full max-w-lg flex-col items-center gap-4">
  <svg
    viewBox={`0 0 ${size} ${size}`}
    role="img"
    aria-label="Ruota dell'almanacco: 12 mesi del calendario agricolo italiano e 24 sekki giapponesi"
    class="h-auto w-full"
    data-sekki-wheel
  >
    <circle cx={cx} cy={cy} r={outerRadius} fill="none" stroke="var(--color-brass)" stroke-opacity="0.35" stroke-width="1" />
    <circle cx={cx} cy={cy} r={innerRadius} fill="none" stroke="var(--color-brass)" stroke-opacity="0.35" stroke-width="1" />
    <circle cx={cx} cy={cy} r={coreRadius} fill="none" stroke="var(--color-brass)" stroke-opacity="0.5" stroke-width="1" />

    {tickAnglesOuter.map((angle) => {
      const inner = pointOnCircle(outerRadius - 10, angle);
      const outer = pointOnCircle(outerRadius, angle);
      return (
        <line
          x1={inner.x}
          y1={inner.y}
          x2={outer.x}
          y2={outer.y}
          stroke="var(--color-brass)"
          stroke-width="1"
          opacity="0.6"
        />
      );
    })}

    {tickAnglesInner.map((angle, i) => {
      const inner = pointOnCircle(innerRadius - 8, angle);
      const outer = pointOnCircle(innerRadius, angle);
      const active = highlightIndex === i;
      return (
        <line
          data-sekki-tick={i}
          x1={inner.x}
          y1={inner.y}
          x2={outer.x}
          y2={outer.y}
          stroke={active ? "var(--color-terracotta)" : "var(--color-stone-text)"}
          stroke-width={active ? "2" : "0.75"}
          opacity={active ? "1" : "0.55"}
        />
      );
    })}

    {monthItems.map((item) => (
      <text
        x={item.x}
        y={item.y}
        transform={item.transform}
        text-anchor="middle"
        dominant-baseline="middle"
        class="fill-brass font-body"
        font-size="13"
        letter-spacing="0.5"
      >
        {item.label}
      </text>
    ))}

    {sekkiItems.map((item, i) => {
      const active = highlightIndex === i;
      return (
        <text
          data-sekki-label={i}
          x={item.x}
          y={item.y}
          transform={item.transform}
          text-anchor="middle"
          dominant-baseline="middle"
          fill={active ? "var(--color-terracotta)" : "var(--color-stone-text)"}
          font-weight={active ? "600" : "400"}
          class="font-body"
          font-size="12"
        >
          {item.label}
        </text>
      );
    })}
  </svg>
</figure>
