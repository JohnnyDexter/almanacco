---
import AlmanacWheel from "./AlmanacWheel.astro";
import type { SiteContent, Lang } from "../i18n/content";
import { withBase } from "../utils/paths";

interface Props {
  lang: Lang;
  t: SiteContent;
}

const { lang, t } = Astro.props;
---

<section class="relative overflow-hidden bg-cream">
  <img
    src={withBase("/images/02-girasoli-hero.jpg")}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-cream/95 via-cream/88 to-cream/60" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto grid max-w-5xl gap-12 px-6 py-20 md:grid-cols-2 md:items-center md:py-28">
    <div>
      <p class="divider-dot flex items-center gap-2 font-noto text-xs uppercase tracking-[0.2em] text-terra">
        {t.hero.kicker}
      </p>
      <h1 class="mt-5">
        <img
          src={withBase("/logo.png")}
          alt={t.hero.title}
          class="h-auto w-56 sm:w-72"
          width="1254"
          height="1254"
        />
      </h1>
      <p class="mt-6 max-w-md font-noto text-base leading-relaxed text-ink-soft">
        {t.hero.subtitle}
      </p>
      <a
        href="#prodotti"
        class="mt-8 inline-block border border-olive px-6 py-3 font-noto text-sm tracking-wide text-olive transition-colors hover:bg-olive hover:text-cream"
      >
        {t.hero.cta}
      </a>
    </div>
    <AlmanacWheel lang={lang} caption={t.hero.wheelCaption} />
  </div>
</section>
