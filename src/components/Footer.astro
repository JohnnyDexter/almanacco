---
import type { SiteContent, Lang } from "../i18n/content";

interface Props {
  lang: Lang;
  t: SiteContent;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-brass/30 bg-ivory-soft">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-8 text-center font-body text-xs text-stone-text sm:flex-row sm:justify-between sm:text-left">
    <p class="font-display tracking-widest text-charcoal">Almanacco</p>
    <p>{t.footer.tagline}</p>
    <p>&copy; {year} Almanacco. {t.footer.rights}</p>
  </div>
</footer>
