---
import { content, type Lang } from "../i18n/content";
import { withBase, langHref } from "../utils/paths";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section class="border-t border-brass/30 bg-ivory py-24">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <p class="divider-dot flex items-center justify-center gap-2 font-body text-xs uppercase tracking-[0.2em] text-forest">
      {t.eventsTeaser.kicker}
    </p>
    <h2 class="mt-4 font-display text-3xl uppercase tracking-wide text-charcoal sm:text-4xl">
      {t.eventsTeaser.title}
    </h2>

    <div class="mt-12 border border-brass/30 bg-ivory-soft p-8 text-left sm:p-10">
      <span class="font-body text-xs uppercase tracking-[0.15em] text-forest">{t.almanacco.eventLabel}</span>
      <h3 class="mt-3 font-subtitle text-2xl italic text-charcoal">{t.almanacco.eventTitle}</h3>
      <p class="mt-4 font-body text-sm leading-relaxed text-stone-text">{t.almanacco.eventText}</p>
    </div>

    <p class="mt-8 font-subtitle text-lg italic text-stone-text">{t.eventsTeaser.moreNote}</p>

    <a
      href={withBase(langHref(lang, "events"))}
      class="mt-8 inline-block bg-forest px-8 py-3 font-body text-sm uppercase tracking-[0.15em] text-ivory transition-colors hover:bg-forest/85"
    >
      {t.eventsTeaser.ctaLabel} →
    </a>
  </div>
</section>
